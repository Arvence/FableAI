# Backend only. Fill in your own account-verified credentials and model locally.
GEMINI_API_KEY=
GEMINI_MODEL=

# Backend-only PostgreSQL URL; percent-encode special characters in credentials.
# Example: postgresql+psycopg://fableai:password@127.0.0.1:5432/fableai
FABLEAI_DATABASE_URL=

# Optional anonymous chat demo on loopback only; project APIs still require credentials.
FABLEAI_LOCAL_DEMO=false
